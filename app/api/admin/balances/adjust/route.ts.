import { NextRequest, NextResponse } from "next/server";
import { supabaseAdmin } from "../../../../../lib/supabase-admin";
import { isAdminUser } from "../../../../../lib/admin";

export const dynamic = "force-dynamic";

function getBearerToken(request: NextRequest) {
  const authorization = request.headers.get("authorization") || "";

  if (!authorization.toLowerCase().startsWith("bearer ")) {
    return null;
  }

  return authorization.slice(7).trim() || null;
}

export async function POST(request: NextRequest) {
  try {
    // Verificar token de sesión
    const accessToken = getBearerToken(request);

    if (!accessToken) {
      return NextResponse.json(
        { ok: false, error: "No autorizado." },
        { status: 401 }
      );
    }

    // Verificar que el usuario sea administrador
    const authorized = await isAdminUser(accessToken);

    if (!authorized) {
      return NextResponse.json(
        { ok: false, error: "Acceso denegado." },
        { status: 403 }
      );
    }

    // Leer y validar los datos
    const body = await request.json();

    const userId =
      typeof body.userId === "string" ? body.userId.trim() : "";

    const amount = Number(body.amount);
    const action = body.action;

    const uuidRegex =
      /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

    if (!uuidRegex.test(userId)) {
      return NextResponse.json(
        { ok: false, error: "El ID del cliente no es válido." },
        { status: 400 }
      );
    }

    if (
      !Number.isFinite(amount) ||
      amount <= 0 ||
      !Number.isSafeInteger(Math.round(amount * 100)) ||
      Math.abs(amount * 100 - Math.round(amount * 100)) > 0.000001
    ) {
      return NextResponse.json(
        {
          ok: false,
          error: "El monto debe ser positivo y tener como máximo dos decimales.",
        },
        { status: 400 }
      );
    }

    if (action !== "ADD" && action !== "SUBTRACT") {
      return NextResponse.json(
        { ok: false, error: "La operación no es válida." },
        { status: 400 }
      );
    }

    // Consultar el saldo actual del cliente
    const { data: profile, error: profileError } = await supabaseAdmin
      .from("profiles")
      .select("id,balance")
      .eq("id", userId)
      .maybeSingle();

    if (profileError) {
      console.error("ERROR CONSULTANDO PERFIL:", profileError);

      return NextResponse.json(
        { ok: false, error: "No se pudo consultar el saldo del cliente." },
        { status: 500 }
      );
    }

    if (!profile) {
      return NextResponse.json(
        { ok: false, error: "No se encontró el cliente." },
        { status: 404 }
      );
    }

    const currentBalance = Number(profile.balance ?? 0);

    if (!Number.isFinite(currentBalance)) {
      return NextResponse.json(
        { ok: false, error: "El saldo actual no es válido." },
        { status: 500 }
      );
    }

    const amountInCents = Math.round(amount * 100);
    const currentBalanceInCents = Math.round(currentBalance * 100);

    if (
      action === "SUBTRACT" &&
      amountInCents > currentBalanceInCents
    ) {
      return NextResponse.json(
        {
          ok: false,
          error: "El cliente no tiene saldo suficiente para esta operación.",
        },
        { status: 400 }
      );
    }

    const newBalanceInCents =
      action === "ADD"
        ? currentBalanceInCents + amountInCents
        : currentBalanceInCents - amountInCents;

    if (!Number.isSafeInteger(newBalanceInCents)) {
      return NextResponse.json(
        { ok: false, error: "El saldo resultante es demasiado grande." },
        { status: 400 }
      );
    }

    const newBalance = newBalanceInCents / 100;

    // Guardar el nuevo saldo
    const { data: updatedProfile, error: updateError } =
      await supabaseAdmin
        .from("profiles")
        .update({ balance: newBalance })
        .eq("id", userId)
        .select("id,email,balance")
        .maybeSingle();

    if (updateError) {
      console.error("ERROR ACTUALIZANDO BALANCE:", updateError);

      return NextResponse.json(
        { ok: false, error: "No se pudo actualizar el saldo." },
        { status: 500 }
      );
    }

    if (!updatedProfile) {
      return NextResponse.json(
        { ok: false, error: "No se pudo confirmar la actualización del saldo." },
        { status: 500 }
      );
    }

    console.log("BALANCE MODIFICADO POR ADMIN:", {
      adminAction: action,
      userId,
      amount,
      newBalance,
    });

    return NextResponse.json({
      ok: true,
      message:
        action === "ADD"
          ? "Saldo sumado correctamente."
          : "Saldo restado correctamente.",
      client: {
        id: updatedProfile.id,
        email: updatedProfile.email,
        balance: Number(updatedProfile.balance ?? 0),
      },
    });
  } catch (error) {
    console.error("ERROR API ADJUST BALANCE:", error);

    return NextResponse.json(
      { ok: false, error: "Error interno del servidor." },
      { status: 500 }
    );
  }
}
