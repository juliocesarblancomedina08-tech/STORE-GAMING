
import { NextResponse } from "next/server";
import { supabaseAdmin } from "../../../../../lib/supabase-admin";

export const dynamic = "force-dynamic";

const ADMIN_EMAIL = "juliocesarblancomedina08@gmail.com";

function jsonError(message: string, status: number) {
  return NextResponse.json(
    { ok: false, error: message },
    {
      status,
      headers: { "Cache-Control": "no-store" },
    }
  );
}

export async function POST(request: Request) {
  try {
    // 1. Validar la sesión.
    const authorization = request.headers.get("authorization") || "";
    const match = authorization.match(/^Bearer\s+(.+)$/i);
    const token = match?.[1]?.trim();

    if (!token) {
      return jsonError("Debes iniciar sesión como administrador.", 401);
    }

    const {
      data: { user },
      error: authError,
    } = await supabaseAdmin.auth.getUser(token);

    if (authError || !user) {
      return jsonError("La sesión no es válida o ha caducado.", 401);
    }

    if (user.email?.toLowerCase() !== ADMIN_EMAIL.toLowerCase()) {
      return jsonError("No tienes permiso para modificar saldos.", 403);
    }

    // 2. Leer y validar los datos.
    let body: {
      userId?: unknown;
      amount?: unknown;
      action?: unknown;
    };

    try {
      body = await request.json();
    } catch {
      return jsonError("Los datos enviados no son JSON válido.", 400);
    }

    if (
      typeof body.userId !== "string" ||
      !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
        body.userId
      )
    ) {
      return jsonError("El usuario indicado no es válido.", 400);
    }

    if (body.action !== "ADD" && body.action !== "SUBTRACT") {
      return jsonError("La operación solicitada no es válida.", 400);
    }

    // Aceptar hasta cuatro decimales.
    const amountText =
      typeof body.amount === "number" && Number.isFinite(body.amount)
        ? String(body.amount)
        : typeof body.amount === "string"
          ? body.amount.trim()
          : "";

    if (!/^\d+(?:\.\d{1,4})?$/.test(amountText)) {
      return jsonError(
        "Introduce una cantidad positiva con un máximo de 4 decimales.",
        400
      );
    }

    if (!/[1-9]/.test(amountText)) {
      return jsonError("La cantidad debe ser mayor que cero.", 400);
    }

    // 3. Ejecutar la función transaccional de Supabase.
    const { data, error } = await supabaseAdmin.rpc(
      "store_gaming_admin_adjust_balance",
      {
        p_user_id: body.userId,
        p_amount: amountText,
        p_action: body.action,
      }
    );

    if (error) {
      console.error("ERROR AJUSTANDO SALDO:", error);

      const message = error.message || "";

      if (message.includes("No se encontró el usuario")) {
        return jsonError("No se encontró el usuario.", 404);
      }

      if (message.includes("no tiene saldo suficiente")) {
        return jsonError("El usuario no tiene saldo suficiente.", 400);
      }

      if (
        message.includes("Operación no válida") ||
        message.includes("como máximo 4 decimales") ||
        message.includes("no es válido")
      ) {
        return jsonError(message, 400);
      }

      return jsonError(
        "No se pudo completar el ajuste. Revisa los registros del servidor.",
        500
      );
    }

    if (!data || data.ok !== true) {
      console.error("RESPUESTA SQL INESPERADA:", data);
      return jsonError("La base de datos no confirmó el ajuste.", 500);
    }

    // 4. Devolver el resultado al navegador.
    return NextResponse.json(
      {
        ok: true,
        message:
          body.action === "ADD"
            ? "Saldo agregado correctamente."
            : "Saldo restado correctamente.",
        client: {
          id: data.userId,
          balance: data.balanceAfter,
        },
        transaction: {
          type: body.action === "ADD" ? "ADMIN_ADD" : "ADMIN_SUBTRACT",
          amount: data.amount,
          balanceBefore: data.balanceBefore,
          balanceAfter: data.balanceAfter,
        },
      },
      {
        status: 200,
        headers: { "Cache-Control": "no-store" },
      }
    );
  } catch (error) {
    console.error("ERROR INESPERADO AJUSTANDO SALDO:", error);

    return jsonError("Ocurrió un error interno al modificar el saldo.", 500);
  }
}
