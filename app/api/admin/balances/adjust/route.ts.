import { NextResponse } from "next/server";
import { supabaseAdmin } from "../../../../../lib/supabase-admin";

export const dynamic = "force-dynamic";

const ADMIN_EMAIL = "juliocesarblancomedina08@gmail.com";

function jsonError(message: string, status: number) {
  return NextResponse.json(
    { ok: false, error: message },
    {
      status,
      headers: { "Cache-Control": "no-store" },
    }
  );
}

export async function POST(request: Request) {
  try {
    // Verificar el token de sesión.
    const authorization = request.headers.get("authorization");
    const token = authorization?.startsWith("Bearer ")
      ? authorization.slice(7).trim()
      : "";

    if (!token) {
      return jsonError("Debes iniciar sesión como administrador.", 401);
    }

    const {
      data: { user },
      error: authError,
    } = await supabaseAdmin.auth.getUser(token);

    if (authError || !user) {
      return jsonError("La sesión no es válida o ha caducado.", 401);
    }

    if (user.email?.toLowerCase() !== ADMIN_EMAIL.toLowerCase()) {
      return jsonError("No tienes permiso para modificar saldos.", 403);
    }

    // Validar los datos recibidos.
    let body: {
      userId?: string;
      amount?: number;
      action?: string;
    };

    try {
      body = await request.json();
    } catch {
      return jsonError("Los datos enviados no son JSON válido.", 400);
    }

    const userId = body.userId;
    const amount = Number(body.amount);
    const action = body.action;

    if (
      typeof userId !== "string" ||
      !userId.trim() ||
      userId.length > 100
    ) {
      return jsonError("El usuario indicado no es válido.", 400);
    }

    if (
      !Number.isFinite(amount) ||
      amount <= 0 ||
      Math.round(amount * 100) !== amount * 100
    ) {
      return jsonError(
        "Introduce una cantidad válida con un máximo de dos decimales.",
        400
      );
    }

    if (action !== "ADD" && action !== "SUBTRACT") {
      return jsonError("La operación solicitada no es válida.", 400);
    }

    // Consultar el saldo actual.
    const {
      data: profile,
      error: profileError,
    } = await supabaseAdmin
      .from("profiles")
      .select("id, balance")
      .eq("id", userId)
      .maybeSingle();

    if (profileError) {
      console.error("Error consultando el perfil:", profileError);
      return jsonError("No se pudo consultar el saldo del usuario.", 500);
    }

    if (!profile) {
      return jsonError("No se encontró el usuario.", 404);
    }

    const currentBalance = Number(profile.balance ?? 0);

    if (!Number.isFinite(currentBalance) || currentBalance < 0) {
      return jsonError("El saldo actual del usuario no es válido.", 500);
    }

    const newBalance =
      action === "ADD"
        ? currentBalance + amount
        : currentBalance - amount;

    if (newBalance < 0) {
      return jsonError("El usuario no tiene saldo suficiente.", 400);
    }

    // Guardar el saldo actualizado.
    const {
      data: updatedProfile,
      error: updateError,
    } = await supabaseAdmin
      .from("profiles")
      .update({ balance: Number(newBalance.toFixed(2)) })
      .eq("id", userId)
      .select("id, balance")
      .single();

    if (updateError || !updatedProfile) {
      console.error("Error actualizando el saldo:", updateError);
      return jsonError("No se pudo guardar el nuevo saldo.", 500);
    }

    return NextResponse.json(
      {
        ok: true,
        message:
          action === "ADD"
            ? "Saldo agregado correctamente."
            : "Saldo restado correctamente.",
        client: {
          id: updatedProfile.id,
          balance: Number(updatedProfile.balance),
        },
      },
      {
        status: 200,
        headers: { "Cache-Control": "no-store" },
      }
    );
  } catch (error) {
    console.error("Error inesperado al ajustar el saldo:", error);

    return jsonError("Ocurrió un error interno al modificar el saldo.", 500);
  }
}
